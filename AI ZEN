-- 6. Feature: Auto Steal Good Eggs
-- ====================================================
AutoStealBtn.MouseButton1Click:Connect(function()
	autoStealEnabled = not autoStealEnabled
	if autoStealEnabled then
		AutoStealBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		AutoStealBtn.Text = "Auto Steal Good Eggs: ON"
	else
		AutoStealBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		AutoStealBtn.Text = "Auto Steal Good Eggs: OFF"
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		if autoStealEnabled and isUnlocked then
			pcall(function()
				for _, obj in pairs(workspace:GetDescendants()) do
					if obj:IsA("Model") or obj:IsA("Part") then
						local name = string.lower(obj.Name)
						if string.find(name, "egg") and (string.find(name, "legendary") or string.find(name, "epic") or string.find(name, "rare") or string.find(name, "gold")) then
							local targetPart = obj:IsA("Part") and obj or obj:FindFirstChildWhichIsA("BasePart")
							if targetPart and humanoidRootPart then
								humanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
								local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
								if prompt then
									fireproximityprompt(prompt)
								end
							end
						end
					end
				end
			end)
		end
	end
end)

